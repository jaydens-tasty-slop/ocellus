# Devices this was measured on, by device tree compatible.
#  vblank: libcamera can't set the frame rate (the simple pipeline has no
#          FrameDurationLimits), so for rates above 30 the app shortens the
#          sensor's vertical blanking itself once the stream runs.
#  dmabuf: the encoder takes the camera's RGBA dma-bufs as they are.
# Per sensor model: autofocus, the viewfinder and photo size, and the
# video modes: label, size, codec, frame rates.
TUNED = {
    # Samsung Galaxy Tab S3 (SM-T820): the simple pipeline with the GPU
    # software ISP, Venus encoder. libcamera picks the smallest sensor mode
    # that holds the size, and the frame rates are what that mode reaches:
    # rear 4208x2368 (39 fps; the encoder manages about 29.8 at 4K and
    # refuses 25, so 4K stays at 24), 2104x1184 (75), 1048x592 (144);
    # front 2576x1932 (30), 1280x960 (60), 640x480 (120). The ISP output
    # is 8 pixels narrower than the sensor mode, and Venus sizes the RGBA
    # buffers it imports for a width that is a multiple of 128 pixels, so
    # all widths are (a narrower buffer is refused).
    'samsung,gts3lwifi': {
        'vblank': True,
        'dmabuf': True,
        'cameras': {
            'imx258': {
                'af': True,
                'photo': (3840, 2160),
                'modes': [
                    ('4K', 3840, 2160, 'h265', (24,)),
                    ('1080p', 1920, 1080, 'h264', (30, 60)),
                    ('720p', 1280, 720, 'h264', (30, 60)),
                    ('576p', 1024, 576, 'h264', (30, 60, 120)),
                ],
            },
            's5k5e3': {
                'af': False,
                'photo': (2568, 1932),
                'modes': [
                    ('1080p', 1920, 1080, 'h264', (30,)),
                    ('864p', 1152, 864, 'h264', (30, 60)),
                    ('384p', 512, 384, 'h264', (30, 60, 120)),
                ],
            },
        },
    },
}

GENERIC_MODES = [('1080p', 1920, 1080), ('720p', 1280, 720), ('480p', 640, 480)]
# largest viewfinder and photo size on devices not in TUNED
GENERIC_PHOTO_PIXELS = 3840 * 2160

# H.264 levels: name, V4L2 enum, macroblocks per second, frame size in MBs
H264_LEVELS = [
    ('3', 8, 40500, 1620), ('3.1', 9, 108000, 3600),
    ('3.2', 10, 216000, 5120), ('4', 11, 245760, 8192),
    ('4.2', 13, 522240, 8704), ('5.1', 15, 983040, 36864),
]

LOCATIONS = {
    'CameraLocationBack': ('back', 'Rear camera'),
    'CameraLocationFront': ('front', 'Front camera'),
    'CameraLocationExternal': ('external', 'External camera'),
}

PICTURES = os.path.expanduser('~/Pictures')
VIDEOS = os.path.expanduser('~/Videos')
CONFIG = os.path.join(GLib.get_user_config_dir(), 'ocellus')

_M = GstVideo.VideoOrientationMethod
# Clockwise quarter turns: sink rotate method, orientation tag
TURNS = [
    (_M.IDENTITY, None),
    (getattr(_M, '90R'), 'rotate-90'),
    (getattr(_M, '180'), 'rotate-180'),
    (getattr(_M, '90L'), 'rotate-270'),
]

AUDIO_ELEMENTS = ('asrc', 'aconv', 'aresample', 'aenc', 'aparse', 'aqueue')

